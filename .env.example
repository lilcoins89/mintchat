# Anthropic Messages API — required for live agent chat. Keep the value server-side.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# The supplied architecture requests this beta. Override only when migrating the connector format.
ANTHROPIC_MCP_BETA=mcp-client-2025-04-04

# PayBox OAuth bearer access token for the scoped MCP connection; it may expire and need rotation.
PAYBOX_ACCESS_TOKEN=

# Optional Jupiter Developer Platform key for quotes and Jupiter Shield warnings.
JUPITER_API_KEY=

# Required trading guardrails. Write actions fail closed if either cap is missing or invalid.
MAX_TRADE_USD=25
MAX_DAILY_USD=100

# Same-origin protection. Set to the public application origin in the deployed environment.
APP_ORIGIN=http://localhost:3000
# Local HTTP development only: use false + Lax. HTTPS Preview/deployment should use true + None.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# Public endpoints; override SOLANA_RPC_URL only with a trusted HTTPS provider.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
DEXSCREENER_API_BASE=https://api.dexscreener.com

# Local runtime. Manus supplies DATABASE_URL to the server-enabled project.
PORT=3000
NODE_ENV=development
